{
  "name": "@salixiaholdings/cloudflare-postman",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministically generated modular Postman collections for Cloudflare's official API schema.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "openapi-to-postmanv2": {
      "js-yaml": "4.3.1",
      "yaml": "1.10.3"
    },
    "postman-collection": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "preinstall": "node scripts/require-node.mjs",
    "fetch:schema": "node scripts/fetch-schema.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run generate:check && npm run validate",
    "upstream:check": "node scripts/upstream-update.mjs --check",
    "upstream:update": "node scripts/upstream-update.mjs --apply",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "openapi-to-postmanv2": "6.3.3",
    "yaml": "2.9.0"
  }
}
